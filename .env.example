# Plantilla de variables. Copiar a .env y rellenar. NO poner credenciales reales aqui:
# este fichero se versiona y el repositorio es publico.

# ---------- BASE DE DATOS ----------
# En local (docker compose) los servicios se conectan al contenedor "postgres".
# En Cloud Run se usa una base gestionada (Neon) via R2DBC con TLS.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=financial_db
POSTGRES_USER=demo_user
POSTGRES_PASS=cambiame

# R2DBC (lo que leen de verdad customer-service y financial-products-service)
SPRING_R2DBC_URL=r2dbc:postgresql://postgres:5432/financial_db
SPRING_R2DBC_USERNAME=demo_user
SPRING_R2DBC_PASSWORD=cambiame

# ---------- CIFRADO ----------
# Clave AES de 16, 24 o 32 bytes. La de la demo es publica a proposito.
ENCRYPTION_SECRET_KEY=MySecretKey12345
ENCRYPTION_ALGORITHM=AES/ECB/PKCS5Padding
ENCRYPTION_CHARSET=UTF-8
# enhanced (por defecto) | basic
ENCRYPTION_IMPLEMENTATION=enhanced

# ---------- OAUTH2 (solo perfil prod) ----------
# Sin valor por defecto: si se define, Spring crea el JwtDecoder al arrancar.
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=

# ---------- URLS DE MICROSERVICIOS (las usa el BFF) ----------
SERVICES_CUSTOMER_BASE_URL=http://customer-service:8081
SERVICES_FINANCIAL_PRODUCTS_BASE_URL=http://financial-products-service:8082

# ---------- SPRING ----------
# dev | docker | demo | prod
SPRING_PROFILES_ACTIVE=dev
# Cloud Run inyecta PORT automaticamente
PORT=8080
# all | bff | customer | products
APP_MODULE=all

# ---------- DEMO PUBLICA ----------
DEMO_ENABLED=false
DEMO_CODIGOS=CUST001,CUST002,CUST003,CUST004,CUST005
# always en la demo (schema + seed idempotentes), never si la base ya esta cargada
SQL_INIT_MODE=never

# ---------- MONITORING / ACTUATOR ----------
MANAGEMENT_ENDPOINTS_ENABLED=true
ACTUATOR_EXPOSE=health,info,metrics

# ---------- OPENAPI / SWAGGER ----------
SPRINGDOC_ENABLED=true
SWAGGER_UI_ENABLED=true

# ---------- LOGGING ----------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_FINANCIAL=DEBUG

# ---------- RENDIMIENTO ----------
WEBFLUX_MAX_IN_MEMORY_SIZE=10MB
R2DBC_POOL_INITIAL_SIZE=1
R2DBC_POOL_MAX_SIZE=5
