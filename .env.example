# 🗄DATABASE CONFIGURATION
POSTGRES_HOST=161.132.51.231
POSTGRES_PORT=5432
POSTGRES_DB=financial_db
POSTGRES_USER=admin
POSTGRES_PASS=perupcs123

# ENCRYPTION CONFIGURATION
ENCRYPTION_SECRET_KEY=MySecretKey12345
ENCRYPTION_ALGORITHM=AES/ECB/PKCS5Padding
ENCRYPTION_CHARSET=UTF-8

# OAUTH2 CONFIGURATION
OAUTH2_ISSUER_URI=http://localhost:9000/realms/financial
OAUTH2_JWK_SET_URI=http://localhost:9000/realms/financial/protocol/openid-connect/certs
JWT_SECRET=myJwtSecretKeyForDevelopment123456789

# MICROSERVICES URLS
CUSTOMER_SERVICE_URL=http://customer-service:8081
FINANCIAL_PRODUCTS_SERVICE_URL=http://financial-products-service:8082
BFF_SERVICE_URL=http://bff-service:8080

# SPRING CONFIGURATION
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xmx512m -Xms256m

# MONITORING / ACTUATOR
MANAGEMENT_ENDPOINTS_ENABLED=true
ACTUATOR_EXPOSE=health,info,metrics,prometheus

# OPENAPI / SWAGGER
SPRINGDOC_ENABLED=true
SWAGGER_UI_ENABLED=true

# LOGGING
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_FINANCIAL=DEBUG
CORRELATION_ID_HEADER=X-Correlation-ID

# AOP CONFIGURATION
AOP_AUTO_PROXY=true
AOP_PROXY_TARGET_CLASS=true

# PERFORMANCE
WEBFLUX_MAX_IN_MEMORY_SIZE=10MB
R2DBC_POOL_MAX_SIZE=20
R2DBC_POOL_INITIAL_SIZE=5

# DOCKER NETWORK
DOCKER_NETWORK=financial-network

# KEYCLOAK (para entorno local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:9000
